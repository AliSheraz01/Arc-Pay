# ─────────────────────────────────────────────────────────────────────────────
# EASYZPAY CHAT-TO-PAY BACKEND CONFIGURATION
# ─────────────────────────────────────────────────────────────────────────────

# 1. DATABASE CONFIGURATION (TURSO / LIBSQL)
DATABASE_URL=libsql://your-database-name.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token-here

# 2. ARC CHAIN NETWORK & RPC CONFIGURATION
NETWORK_MODE=mainnet
CHAIN_ID=5042
RPC_URL=https://rpc.mainnet.arc.io
EXPLORER_URL=https://explorer.arc.io
USDC_ADDRESS=0x3600000000000000000000000000000000000000
REGISTRY_ADDRESS=0x0D09b1348455540a6394c9d1Bf2F7C2b0cC40E6D

# 3. DEPLOYED SMART ACCOUNT & SESSION KEY CONTRACTS (ARC MAINNET)
ENTRY_POINT_ADDRESS=0x5FF137D4b0FDCD49DcA30c7CF57E578a026d2789
SESSION_KEY_MODULE_ADDRESS=0xbf4286a0A3E47F33c1DB9DC0E2aB2F8FC01edd77
ACCOUNT_FACTORY_ADDRESS=0x994a7D6A2764A3Bf4Db80337e58256d265982E05

# 4. CHAT-TO-PAY SECURITY & RELAYER (GAS SPONSOR)
# Relayer private key used to sponsor gas and submit policy-checked UserOperations to Arc Chain
RELAYER_PRIVATE_KEY=0x_your_arc_mainnet_relayer_private_key_here
# Strong 32-character secret key used to encrypt session private keys at rest (AES-256-GCM)
CHAT_SESSION_SECRET=your-secure-random-32-character-secret-key!

# 5. WHATSAPP PROVIDER 1: GREEN-API (FREE DEVELOPER TIER - RECOMMENDED FOR QR CODE)
# Instance ID from Green-API console (e.g. 1101823456)
GREEN_API_ID_INSTANCE=your_green_api_id_instance
# API Token from Green-API console
GREEN_API_TOKEN_INSTANCE=your_green_api_token_instance
# Green-API Host (Default: https://api.green-api.com)
GREEN_API_HOST=https://api.green-api.com

# 6. WHATSAPP PROVIDER 2: META CLOUD API (OPTIONAL)
WHATSAPP_PHONE_NUMBER_ID=109876543210987
WHATSAPP_ACCESS_TOKEN=EAAG...your_meta_system_user_access_token_here
WHATSAPP_VERIFY_TOKEN=easyzpay_arc_webhook_secure_2026
WHATSAPP_BOT_NUMBER=15551234567

# 7. SERVER PORT
PORT=3001
