// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id               String          @id @default(uuid())
  email            String?
  address          String          @unique
  username         String?         @unique
  walletId         String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  socialAccounts   SocialAccount[]
  crossPays        CrossPay[]
  payoutBatches    PayoutBatch[]

  @@index([address])
}

model SocialAccount {
  id             String   @id @default(uuid())
  userId         String
  provider       String   @default("x")
  providerUserId String   // Immutable X User ID (e.g. "123456789")
  username       String   // Current X handle e.g. "ali" or "ali_web3"
  displayName    String?
  avatar         String?
  connectedAt    DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([username])
  @@index([provider, username])
}

model CrossPay {
  id                 String   @id @default(uuid())
  userId             String?
  sourceChain        Int      // chainId
  destinationChain   Int      // chainId
  amount             String
  token              String   @default("USDC")
  senderAddress      String
  recipientAddress   String
  recipientUsername  String?
  status             String   @default("CREATED") // CREATED, VALIDATING, SOURCE_TRANSACTION_PENDING, SOURCE_CONFIRMED, ATTESTATION_PENDING, ATTESTATION_RECEIVED, DESTINATION_TRANSACTION_PENDING, COMPLETED, VALIDATION_FAILED, SOURCE_FAILED, ATTESTATION_FAILED, DESTINATION_FAILED, EXPIRED, CANCELLED, RECOVERY_REQUIRED
  sourceTxHash       String?
  destinationTxHash  String?
  cctpMessageId      String?  @unique
  attestationStatus  String?  // pending, complete, failed
  attestationBytes   String?
  errorReason        String?
  retryCount         Int      @default(0)
  idempotencyKey     String?  @unique
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  user               User?    @relation(fields: [userId], references: [id])
}

model PayoutBatch {
  id              String       @id @default(uuid())
  userId          String?
  senderAddress   String
  totalAmount     String
  token           String       @default("USDC")
  sourceChain     Int
  status          String       @default("DRAFT") // DRAFT, VALIDATING, READY, PROCESSING, PARTIALLY_COMPLETED, COMPLETED, FAILED, PARTIALLY_FAILED, CANCELLED
  totalRecipients Int          @default(0)
  completedCount  Int          @default(0)
  failedCount     Int          @default(0)
  idempotencyKey  String?      @unique
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  items           PayoutItem[]
  user            User?        @relation(fields: [userId], references: [id])
}

model PayoutItem {
  id                  String      @id @default(uuid())
  batchId             String
  recipientType       String      @default("wallet") // username, x, wallet
  recipientIdentifier String
  recipientAddress    String
  amount              String
  destinationChain    Int?
  memo                String?
  status              String      @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED
  sourceTxHash        String?
  destinationTxHash   String?
  cctpMessageId       String?
  errorReason         String?
  retryCount          Int         @default(0)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  batch               PayoutBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
}

model Transaction {
  id                String   @id @default(uuid())
  txHash            String
  fromAddress       String
  toAddress         String
  amount            String
  token             String   @default("USDC")
  chainId           Int      @default(5042)
  memo              String?
  status            String   @default("COMPLETED") // PENDING, SUBMITTED, CONFIRMED, FAILED
  type              String   @default("SEND") // SEND, RECEIVE, CROSS_PAY, BOUNTY, REQUEST
  blockNumber       Int?
  sourceChain       Int?
  destinationChain  Int?
  destinationTxHash String?
  route             String?
  senderUserId      String?
  recipientUserId   String?
  recipientUsername  String?
  recipientXUsername String?
  cctpMessageId     String?  @unique
  explorerUrl       String?
  timestamp         DateTime @default(now())
  confirmedAt       DateTime?

  @@unique([txHash, toAddress, amount])
  @@index([txHash])
  @@index([fromAddress])
  @@index([toAddress])
  @@index([timestamp])
  @@index([status])
}

model Party {
  id             String   @id @default(uuid())
  name           String
  creatorAddress String
  splitType      String   @default("equal") // equal, custom, percentage
  totalAmount    String
  token          String   @default("USDC")
  chainId        Int      @default(5042)
  status         String   @default("DRAFT") // DRAFT, ACTIVE, COMPLETED, CANCELLED
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  participants   PartyParticipant[]
}

model PartyParticipant {
  id              String   @id @default(uuid())
  partyId         String
  identifier      String
  resolvedAddress String?
  amount          String
  status          String   @default("PENDING") // PENDING, PAID, FAILED
  txHash          String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  party           Party    @relation(fields: [partyId], references: [id], onDelete: Cascade)
}

model Bounty {
  id             String   @id @default(uuid())
  bountyHash     String?  @unique // bytes32 hex hash used in on-chain escrow
  title          String
  description    String?
  creatorAddress String
  prizeAmount    String
  token          String   @default("USDC")
  chainId        Int      @default(5042)
  status         String   @default("OPEN") // DRAFT, OPEN, UNDER_REVIEW, COMPLETED, CANCELLED
  escrowStatus   String   @default("UNFUNDED") // UNFUNDED, FUNDED, PAID, REFUNDED
  category       String?  @default("Development")
  difficulty     String?  @default("Medium")
  tasks          String?  // JSON serialized task checklist
  requirements   String?  // Submission requirements
  deadline       DateTime?
  fundTxHash     String?
  winnerAddress  String?
  rewardTxHash   String?
  refundTxHash   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  submissions    BountySubmission[]

  @@index([creatorAddress])
  @@index([status])
}

model BountySubmission {
  id               String   @id @default(uuid())
  bountyId         String
  submitterAddress String
  content          String
  links            String?  // JSON string or URL proofs
  status           String   @default("PENDING") // DRAFT, PENDING, UNDER_REVIEW, WINNER, REJECTED
  rewardAmount     String?
  rewardTxHash     String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  bounty           Bounty   @relation(fields: [bountyId], references: [id], onDelete: Cascade)

  @@index([bountyId])
  @@index([submitterAddress])
}

model PaymentRequest {
  id          String   @id @default(uuid())
  fromAddress String
  toAddress   String?
  amount      String
  memo        String?
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())
}

model SyncState {
  key   String @id
  value String
}

model RecoveryRequest {
  id            String   @id @default(uuid())
  transactionId String   @unique
  userAddress   String
  amount        String
  sourceChain   Int
  destChain     Int
  status        String   @default("PENDING") // PENDING, RECOVERED, FAILED
  cctpMessageId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model PayoutTemplate {
  id           String   @id @default(uuid())
  name         String
  description  String?
  recipients   String   // JSON string representing Recipient[]: { address: string, name?: string, amount: string }
  totalAmount  String   // Total USDC in 6-decimal format (string)
  ownerAddress String   // User who created the template
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model ScheduledPayout {
  id           String   @id @default(uuid())
  name         String
  description  String?
  frequency    String   // MONTHLY, WEEKLY, ONE_TIME
  recipients   String   // JSON string representing Recipient[]: { address: string, name?: string, amount: string }
  totalAmount  String   // Total USDC in 6-decimal format (string)
  nextRun      DateTime
  status       String   @default("ACTIVE") // ACTIVE, PAUSED, COMPLETED
  ownerAddress String   // User who created the schedule
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model WhatsAppSession {
  id                         String              @id @default(uuid())
  phoneId                    String?             @unique // WhatsApp sender phone number or ID
  pairingToken               String              @unique // Time-sensitive code (e.g. ARC-8492)
  pairingTokenExpiresAt      DateTime
  smartAccountAddress        String
  ownerAddress               String
  sessionPublicKey           String              // Session key address
  sessionPrivateKeyEncrypted String              // Encrypted private key for relayer
  spendingLimit              String              // In USDC (e.g. "50.0")
  spentAmount                String              @default("0")
  validUntil                 DateTime
  status                     String              @default("PENDING_PAIRING") // PENDING_PAIRING, PAIRED, EXPIRED, REVOKED
  createdAt                  DateTime            @default(now())
  updatedAt                  DateTime            @updatedAt
  intents                    ChatPaymentIntent[]

  @@index([phoneId])
  @@index([pairingToken])
  @@index([ownerAddress])
}

model ChatPaymentIntent {
  id               String          @id @default(uuid())
  phoneId          String
  sessionId        String
  rawMessage       String
  action           String          @default("PAY")
  amount           String          // e.g. "5.0"
  asset            String          @default("USDC")
  recipientInput   String          // e.g. "@alisheraz" or "0x..."
  recipientType    String          // "USERNAME" | "WALLET"
  resolvedAddress  String          // Validated 0x address
  status           String          @default("AWAITING_CONFIRMATION") // AWAITING_CONFIRMATION, CONFIRMED, REJECTED, EXECUTED, FAILED
  expiresAt        DateTime
  txHash           String?
  userOpHash       String?
  errorMessage     String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  session          WhatsAppSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([phoneId])
  @@index([sessionId])
  @@index([status])
}

model XBotTransaction {
  id                String   @id @default(uuid())
  tweetId           String   @unique
  senderXId         String
  senderUsername    String?
  senderAddress     String?
  recipientUsername String
  recipientAddress  String
  grossAmount       String   // e.g. "10.00"
  netAmount         String   // e.g. "9.90"
  feeAmount         String   // e.g. "0.10" (1% protocol fee)
  txHash            String
  status            String   @default("CONFIRMED") // PENDING, CONFIRMED, FAILED
  action            String   @default("TIP") // TIP, PAY, BOUNTY
  createdAt         DateTime @default(now())

  @@index([tweetId])
  @@index([senderXId])
  @@index([recipientUsername])
  @@index([createdAt])
}


